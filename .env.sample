# Azure OpenAI (see VAOSAI/.env for actual key; this can also be set here directly)
AZURE_OPENAI_API_KEY=

# Vista-API-X (shared by appointment + note-writing RPC calls)
VISTA_API_BASE_URL=
VISTA_SITE_ID=
VISTA_API_KEY=

# PIV card auth via sts-token-generator.exe (see sts-token/ directory)
# STS_EXE only needed to override the default sts-token/sts-token-generator.exe path
STS_EXE=
STS_ENV=preprod
PIV_SERIAL=

# VistA provider identity used to create appointments and sign notes
VISTA_DUZ=
VISTA_ESIG_CODE=

# Clinic / resource used when creating past appointments (GENERAL MEDICINE defaults)
VISTA_CLINIC_IEN=23
VISTA_RESOURCE_IEN=2

# TIU note title used when writing progress notes (Task 5)
VISTA_NOTE_TITLE_IEN=
