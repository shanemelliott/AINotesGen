          "unit": "g/dL",
          "range": {
            "low": 2.8,
            "high": 3.5
          }
        }
      ],
      "direct_transition": "Burn_Unit_Admission"
    },
    "Burn_Unit_Admission": {
      "type": "Procedure",
      "reason": "combat_burn",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "183450002",
          "display": "Admission to burn unit (procedure)"
        }
      ],
      "direct_transition": "Prescribe_Opioid"
    },
    "Prescribe_Opioid": {
