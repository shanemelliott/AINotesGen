{
  "name": "Forced combat burn",
  "remarks": [
    "Test-data module for the veteran test population: every patient run with this module gets a full",
    "thickness burn between age 19 and 23, with a burn unit admission and two follow-up visits. Only load it (-d)",
    "in the run that should produce burn injuries.",
    "Codes checked against the VistA loader on dev (CDSP UTIL LOAD PREFLIGHT) on 2026-10-07: condition 403192003",
    "maps to ICD-10 and ICD-9; procedure 183450002 maps; scar 275322007 maps to ICD-10 L90.5; chronic pain",
    "82423001 has no ICD map (SNOMED-only fallback). Meds 1049221 (acetaminophen / oxycodone), 106351 (silver",
    "sulfadiazine 1% cream) and 197805 (ibuprofen 400 MG) resolve to drugs; vitals 85354-9, 8867-4, 9279-1,",
    "8331-1, 72514-3 and the CBC and metabolic panel LOINC codes map."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Wait_Until_19"
    },
    "Wait_Until_19": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 19,
        "unit": "years"
      },
      "direct_transition": "Time_In_Service"
    },
    "Time_In_Service": {
      "type": "Delay",
      "range": {
        "low": 0,
        "high": 4,
        "unit": "years"
      },
      "direct_transition": "Full_Thickness_Burn"
    },
    "Full_Thickness_Burn": {
      "type": "ConditionOnset",
      "target_encounter": "Trauma_Admission",
      "assign_to_attribute": "combat_burn",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "403192003",
          "display": "Full thickness burn (disorder)"
        }
      ],
      "direct_transition": "Trauma_Admission"
    },
    "Trauma_Admission": {
      "type": "Encounter",
      "encounter_class": "emergency",
      "reason": "combat_burn",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "50849002",
          "display": "Emergency room admission (procedure)"
        }
      ],
      "direct_transition": "ED_Blood_Pressure"
    },
    "ED_Blood_Pressure": {
      "type": "MultiObservation",
      "category": "vital-signs",
      "codes": [
        {
          "system": "LOINC",
          "code": "85354-9",
          "display": "Blood pressure panel with all children optional"
        }
      ],
      "observations": [
        {
          "category": "vital-signs",
          "codes": [
            {
              "system": "LOINC",
              "code": "8480-6",
              "display": "Systolic Blood Pressure"
            }
          ],
          "unit": "mm[Hg]",
          "range": {
            "low": 98,
            "high": 118
          }
        },
        {
          "category": "vital-signs",
          "codes": [
            {
              "system": "LOINC",
              "code": "8462-4",
              "display": "Diastolic Blood Pressure"
            }
          ],
          "unit": "mm[Hg]",
          "range": {
            "low": 60,
            "high": 75
          }
        }
      ],
      "direct_transition": "ED_Heart_Rate"
    },
    "ED_Heart_Rate": {
      "type": "Observation",
      "category": "vital-signs",
      "codes": [
        {
          "system": "LOINC",
          "code": "8867-4",
          "display": "Heart rate"
        }
      ],
      "unit": "/min",
      "range": {
        "low": 104,
        "high": 128
      },
      "direct_transition": "ED_Respiratory_Rate"
    },
    "ED_Respiratory_Rate": {
      "type": "Observation",
      "category": "vital-signs",
      "codes": [
        {
          "system": "LOINC",
          "code": "9279-1",
          "display": "Respiratory rate"
        }
      ],
      "unit": "/min",
      "range": {
        "low": 20,
        "high": 26
      },
      "direct_transition": "ED_Temperature"
    },
    "ED_Temperature": {
      "type": "Observation",
      "category": "vital-signs",
